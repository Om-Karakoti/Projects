# Backend Environment Variables
ENVIRONMENT=development
PORT=8000

# PostgreSQL Connection String (Optional for local testing; required for live PostgreSQL)
# Example: postgresql://postgres:your_password@localhost:5432/paytm_growth_ai
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/paytm_growth_ai

# Google Gemini API Key for conversational AI business assistant
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Allowed Frontend Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://*.vercel.app
